# Copy to .env and fill in. Never commit the filled-in file.
#
# Cloudflare Workers bind env at REQUEST time, so server code must read
# process.env inside a handler — never at module scope (see config.server.ts).

# ---------------------------------------------------------------- Supabase --
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Service role bypasses RLS. Server-only — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

# Browser-visible copies. Anything VITE_-prefixed is inlined into the client
# bundle, so only ever put publishable values here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# ------------------------------------------------------------------- AI ----
# Provider is resolved in src/lib/ai-config.server.ts. Set AI_PROVIDER to pin
# one explicitly; otherwise the first configured key wins, in this order:
#   gemini -> alibaba -> cerebras -> lovable
LOVABLE_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
# Alibaba Cloud Model Studio (Qwen). AI_PROVIDER=alibaba to use it. Keys are
# per region: the default endpoint is Singapore; for another region set
#   US (Virginia)   https://dashscope-us.aliyuncs.com/compatible-mode/v1
#   China (Beijing) https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
# Optional overrides. Defaults live in ai-config.server.ts.
AI_PROVIDER=
AI_MODEL=
# AI_PROVIDER=claude-cli runs the local `claude` CLI on its logged-in Claude
# subscription instead of an API key (AI_MODEL: sonnet | opus | haiku). It needs
# a Node server that can start processes, so it works under `npm run dev` only,
# never on Cloudflare Workers. It is never chosen by fallback.
CLAUDE_CLI_PATH=
CLAUDE_CLI_TIMEOUT_MS=
CLAUDE_CLI_CONCURRENCY=

# How many times a generated article is re-run against its failing SEO checks
# (default 3). Each pass rewrites the whole article: lower it when the model is
# slow, such as the local Claude CLI.
ARTICLE_OPTIMIZE_PASSES=

# Related-video lookup for generated articles. Without a key the writer falls
# back to scraping YouTube search, and an article simply ships without a video
# if neither works.
YOUTUBE_API_KEY=

# Live web research for article generation. Degrades gracefully if unset.
FIRECRAWL_API_KEY=

# --------------------------------------------------------------- Payments --
# Your own Stripe secret keys (Developers -> API keys). Server only.
STRIPE_SANDBOX_API_KEY=
STRIPE_LIVE_API_KEY=
PAYMENTS_SANDBOX_WEBHOOK_SECRET=
PAYMENTS_LIVE_WEBHOOK_SECRET=
# Which Stripe environment the server trusts. NEVER take this from the client:
# both keys live on the same worker, so a client-chosen "sandbox" would let a
# user mint a free entitlement with a test-mode checkout.
PAYMENTS_ENVIRONMENT=sandbox
# Publishable key only. Its pk_test_/pk_live_ prefix also selects the client
# environment (see src/lib/stripe.ts).
VITE_PAYMENTS_CLIENT_TOKEN=

# ----------------------------------------------------------------- Cron ----
# Shared secret for POST /api/public/hooks/autopilot-run. Without it the
# endpoint is an open trigger for paid LLM + Firecrawl work.
AUTOPILOT_CRON_SECRET=

# Shared secret for POST /api/public/hooks/exchange-run — the backlink
# exchange's daily housekeeping: it verifies hosted links on members' live
# pages (which is what moves credits), charges back links that vanished, and
# refunds what never published. Falls back to AUTOPILOT_CRON_SECRET when unset,
# so one secret can serve both jobs. With neither set the endpoint refuses.
EXCHANGE_CRON_SECRET=

# Shared secret for POST /api/public/hooks/reddit-run — Reddit presence's daily
# job: the weekly discovery sweep for accounts that are due, checks that posted
# replies are still there, and re-measures the threads members are in. Falls
# back to AUTOPILOT_CRON_SECRET. With neither set the endpoint refuses: every
# run spends money at Apify, so an open endpoint is a line into a metered bill.
REDDIT_CRON_SECRET=

# --------------------------------------------------------- Reddit presence --
# Reddit presence reads PUBLIC Reddit threads and PUBLIC Google results through
# Apify. Rankbox never authenticates to Reddit and never posts — there is no
# Reddit credential anywhere in this file, on purpose. Members post their own
# replies from their own accounts.
#
# Unset = the Reddit page says discovery isn't switched on, and nothing throws.
# Reduced function, never a hard failure — same rule as FIRECRAWL_API_KEY.
# Get one at https://console.apify.com/account/integrations
APIFY_TOKEN=

# The two actors, swappable without a code change. "user~actor" or "user/actor".
#   trudax~reddit-scraper-lite   ~$3.40 / 1k results (the default)
#   spookyweb~reddit-scraper     ~$0.60 / 1k results — worth trialling: Reddit
#                                search is the dominant cost of a sweep
# Output is normalised in src/lib/reddit/normalize.ts, which is tolerant of
# differently-named fields. After swapping, run one sweep and check the result.
APIFY_REDDIT_ACTOR=trudax~reddit-scraper-lite
APIFY_SERP_ACTOR=apify~google-search-scraper

# Spend controls. There are three, and they are not optional extras — a sweep
# is free to the member, so nothing THEY do can cap what it costs.
#   1. Per run, enforced BY APIFY (passed as maxTotalChargeUsd). The only cap
#      that is a real limit rather than our own bookkeeping.
APIFY_MAX_CHARGE_USD_PER_RUN=0.50
#   2. Per sweep, across every actor call in it. Runs dry -> the sweep stops
#      hydrating and is marked `partial`. A normal outcome, not an incident.
REDDIT_SWEEP_BUDGET_USD=1.00
#   3. The kill switch. Once the last 30 days' spend across ALL accounts passes
#      this, the cron stops starting anything that costs money. Unset = no
#      ceiling. Set it.
APIFY_MONTHLY_BUDGET_USD=250

# Google results pages fetched per keyword (about 10 results each). Billed per
# page, so this multiplies the cheapest line of a sweep. 2 = positions 1-20.
APIFY_SERP_PAGES=2
APIFY_TIMEOUT_MS=120000

# Unit prices used to ESTIMATE spend for the budgets above, USD per 1,000.
# Keep in step with the actors' listed prices if you swap them.
APIFY_REDDIT_COST_PER_1K=3.40
APIFY_SERP_COST_PER_1K=1.80
APIFY_AI_COST_PER_1K=25

# Which AI engines a sweep asks, for its top three keywords. Comma-separated:
#   chatgpt, perplexity, gemini, google_ai_overview
# EMPTY BY DEFAULT, and that is a decision, not an oversight. With it empty,
# nothing is asked and every thread reads "AI not checked" — which is true.
# These add-ons automate consumer AI products; validate one on a single sweep,
# read what comes back, and watch the cost before leaving any of them on.
REDDIT_AI_ENGINES=

# ------------------------------------------------------------ Rate limits --
PUBLIC_API_IP_RATE_LIMIT=300
PUBLIC_API_USER_RATE_LIMIT=120
# Per-user cap on the authenticated AI server functions (per minute).
AI_USER_RATE_LIMIT=12

# ---------------------------------------------------------------- Content --
NOTION_API_KEY=

# ------------------------------------------------------------ Local dev ----
# Set to 1 to run the redesigned onboarding/dashboard against in-memory
# fixtures instead of Supabase. Off in production.
VITE_MOCK_DATA=

